{
  "name": "backofficefrontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:docs",
    "preview": "vite preview",
    "test:browser": "node tests/browser.mjs",
    "test:forms": "node tests/forms.mjs",
    "test:production": "node tests/production.mjs",
    "test:revisions": "node tests/revisions.mjs",
    "theme:check": "command-center-sdk theme audit --path src",
    "check": "npm run docs:check && npm run theme:check && tsc -b",
    "build:app": "tsc -b && vite build",
    "docs:sync": "node scripts/sync-docs-navigation.mjs",
    "docs:check": "node scripts/check-docs-toolchain.mjs && npm run docs:sync -- --check && node scripts/validate-docs.mjs",
    "docs:dev": "npm run docs:sync && docusaurus start documentation --host 127.0.0.1 --port 3011 --no-open",
    "build:docs": "npm run docs:sync && docusaurus build documentation --out-dir ../dist/docs",
    "test:renewals": "node tests/renewals.mjs",
    "test:assistant": "node tests/assistant.mjs",
    "test:assistant:local": "node tests/assistant-local.mjs",
    "test:docs:local": "node tests/local-docs.mjs",
    "test:admin": "node tests/admin.mjs",
    "test:admin:overview": "node tests/admin-overview.mjs",
    "test:comparisons": "node tests/comparisons.mjs",
    "test:document-sets": "node tests/document-sets.mjs",
    "test:document-sets:api": "node tests/document-sets-api.mjs"
  },
  "dependencies": {
    "@dev-mainsequence/command-center-ai": "0.0.16",
    "@dev-mainsequence/command-center-sdk": "0.5.18",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "1.62.1",
    "typescript": "^5.9.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": "24.x"
  }
}
