{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Back Office: local stack",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/${config:backoffice.backendPath}/.venv/bin/python",
      "program": "${workspaceFolder}/scripts/dev_stack.py",
      "args": [
        "--backend-dir", "${workspaceFolder}/${config:backoffice.backendPath}",
        "--api-port", "8001",
        "--site-port", "5174",
        "--metatables-port", "18473",
        "--sdk-session-source", "vscode"
      ],
      "cwd": "${workspaceFolder}/${config:backoffice.backendPath}",
      "envFile": "${workspaceFolder}/${config:backoffice.backendPath}/.env",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "subProcess": true,
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Back Office ready: (http://127\\.0\\.0\\.1:[0-9]+/)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Back Office: browser debugger",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5174/",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
